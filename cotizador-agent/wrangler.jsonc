{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cotizador-agent-prototipo",
  "main": "src/server.js",
  // Deja esto como la fecha de hoy cuando lo corras
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Binding gratuito de Workers AI -- para arrancar sin pedir API key de Anthropic todavia
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CotizadorAgent",
        "class_name": "CotizadorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CotizadorAgent"]
    }
  ]
}
